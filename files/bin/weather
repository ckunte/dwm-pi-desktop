#!/bin/sh
# slstatus weather field: condition icon and temperature from wttr.in
# (location by IP). Prints the cached value instantly and refreshes it in
# the background when older than 15 minutes, so the bar never waits on the
# network. A failed fetch is retried at most once a minute.
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/weather"
mkdir -p "$(dirname "$CACHE")"

stale() { [ ! -f "$1" ] || [ -n "$(find "$1" -mmin +"$2" 2>/dev/null)" ]; }

if stale "$CACHE" 15 && stale "$CACHE.try" 1; then
	touch "$CACHE.try"
	(
		out=$(curl -fsS --max-time 10 "wttr.in/?format=%c+%t") || exit 0
		# wttr.in can answer 200 with an error sentence; keep only short results.
		[ -n "$out" ] && [ "${#out}" -le 30 ] || exit 0
		# Drop the emoji variation selector (U+FE0F) that follows the icon:
		# Xft can't draw it and shows a box. Also squeeze the double space.
		vs=$(printf '\357\270\217')
		out=$(printf '%s' "$out" | sed "s/$vs//g" | tr -s ' ')
		printf '%s\n' "$out" > "$CACHE.tmp" && mv "$CACHE.tmp" "$CACHE"
	) >/dev/null 2>&1 &
fi

if [ -s "$CACHE" ]; then cat "$CACHE"; else echo "..."; fi
