#!/bin/sh
# dwm keybind (Super+u): dmenu-driven mount/unmount for USB drives, for
# manual mount after unplugging, or safely detaching before pulling one.
# HOTPLUG (not RM) so USB SSDs and enclosures that report RM=0 still show up.
set -eu

list_unmounted() {
	lsblk -rno NAME,HOTPLUG,TYPE,MOUNTPOINT | awk '$2=="1" && $3=="part" && $4=="" {print "/dev/"$1}'
}
list_mounted() {
	lsblk -rno NAME,HOTPLUG,TYPE,MOUNTPOINT | awk '$2=="1" && $3=="part" && $4!="" {print "/dev/"$1" -> "$4}'
}

action=$(printf 'mount\nunmount (+ eject)' | dmenu -i -p "USB drive:")
[ -z "$action" ] && exit 0

case "$action" in
mount)
	dev=$(list_unmounted | dmenu -i -p "Mount which device?")
	[ -z "$dev" ] && exit 0
	udisksctl mount -b "$dev"
	;;
"unmount (+ eject)")
	sel=$(list_mounted | dmenu -i -p "Unmount which device?")
	[ -z "$sel" ] && exit 0
	dev=${sel%% *}
	udisksctl unmount -b "$dev"
	udisksctl power-off -b "$dev" 2>/dev/null || true
	;;
esac
